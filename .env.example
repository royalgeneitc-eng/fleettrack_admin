# Postgres connection. On Supabase use the *pooler* connection string
# (Project Settings > Database > Connection pooling, transaction mode, port 6543)
# — the direct host is IPv6-only and unreachable from Vercel/most laptops.
DATABASE_URL=postgres://postgres.xxxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Long random string; signs web + mobile session tokens.
JWT_SECRET=

# Optional: allow self-service signup of new fleet owner workspaces (default true)
ALLOW_SIGNUP=true

# Self-hosted Android updates (optional). APKs are GitHub Releases on this repo,
# published with android/scripts/release.sh. Token: fine-grained, read-only
# "Contents" access to that repository only.
GITHUB_RELEASES_REPO=royalgeneitc-eng/fleettrack_mobile
GITHUB_RELEASES_TOKEN=
# Also offer prereleases (testing builds). Leave unset in production.
# GITHUB_RELEASES_PRERELEASE=true
